apiVersion: apps/v1
kind: Deployment
metadata:
  name: brain-tasks-deployment

spec:
  replicas: 2

  selector:
    matchLabels:
      app: brain-tasks

  template:
    metadata:
      labels:
        app: brain-tasks

    spec:
      containers:
      - name: brain-tasks
        image: vinay2704/brain-tasks-app:v1

        ports:
        - containerPort: 80